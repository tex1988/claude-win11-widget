{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${currentSessionLabel}",
      "size": "Medium",
      "weight": "Bolder",
      "wrap": true,
      "$when": "${hasUsageLimits}"
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "verticalContentAlignment": "Center",
      "$when": "${hasUsageLimits}",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "Image",
              "url": "${sessionBarUri}",
              "size": "Stretch",
              "altText": "${sessionPercent}% used",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${sessionPercent}%",
              "size": "Small",
              "weight": "Bolder",
              "color": "${sessionColor}",
              "isSubtle": "${sessionTextSubtle}",
              "horizontalAlignment": "Right",
              "wrap": false,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${sessionResetLine}",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small",
      "wrap": true,
      "$when": "${hasUsageLimits}"
    },
    {
      "type": "Image",
      "url": "${separatorUri}",
      "size": "Stretch",
      "spacing": "Large",
      "altText": "",
      "separator": false,
      "$when": "${hasUsageLimits}"
    },
    {
      "type": "TextBlock",
      "text": "${weeklyLimitsLabel}",
      "size": "Medium",
      "weight": "Bolder",
      "spacing": "Medium",
      "wrap": true,
      "$when": "${hasUsageLimits}"
    },
    {
      "type": "TextBlock",
      "text": "${allModelsLabel}",
      "size": "Default",
      "weight": "Bolder",
      "isSubtle": true,
      "spacing": "Small",
      "wrap": true,
      "$when": "${hasUsageLimits}"
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "verticalContentAlignment": "Center",
      "$when": "${hasUsageLimits}",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "Image",
              "url": "${weeklyBarUri}",
              "size": "Stretch",
              "altText": "${weeklyPercent}% used",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${weeklyPercent}%",
              "size": "Small",
              "weight": "Bolder",
              "color": "${weeklyColor}",
              "isSubtle": "${weeklyTextSubtle}",
              "horizontalAlignment": "Right",
              "wrap": false,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${weeklyResetLine}",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small",
      "wrap": true,
      "$when": "${hasUsageLimits}"
    },
    {
      "type": "TextBlock",
      "text": "${planLine}",
      "size": "Small",
      "weight": "Bolder",
      "color": "Default",
      "isSubtle": false,
      "wrap": true,
      "$when": "${hasNoLimitsPlanLine}"
    },
    {
      "type": "TextBlock",
      "text": "${noUsageLimitsLine}",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small",
      "wrap": true,
      "$when": "${hasNoUsageLimits}"
    },
    {
      "type": "Image",
      "url": "${separatorUri}",
      "size": "Stretch",
      "spacing": "Large",
      "altText": "",
      "separator": false,
      "$when": "${hasPlanAndPaymentLine}"
    },
    {
      "type": "TextBlock",
      "text": "${planLine}",
      "size": "Small",
      "weight": "Bolder",
      "color": "Default",
      "isSubtle": false,
      "spacing": "Medium",
      "wrap": true,
      "$when": "${hasPlanLine}"
    },
    {
      "type": "TextBlock",
      "text": "${paymentLine}",
      "size": "Small",
      "weight": "${nextPaymentWeight}",
      "color": "${nextPaymentColor}",
      "isSubtle": false,
      "spacing": "Small",
      "wrap": true,
      "$when": "${hasPaymentLine}"
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "$when": "${hasCreditToggle}",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "${creditHeaderLabel}",
              "size": "Small",
              "weight": "Default",
              "color": "Default",
              "isSubtle": false,
              "wrap": true,
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "spacing": "Small",
          "selectAction": {
            "type": "Action.Execute",
            "verb": "ToggleCredit",
            "data": { "enable": "${creditToggleEnable}" }
          },
          "items": [
            {
              "type": "TextBlock",
              "text": "${creditHeaderValue}",
              "size": "Small",
              "weight": "Bolder",
              "color": "Accent",
              "isSubtle": false,
              "wrap": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "$when": "${hasCreditNonToggle}",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "${creditHeaderLabel}",
              "size": "Small",
              "weight": "Default",
              "color": "Default",
              "isSubtle": false,
              "wrap": true,
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "spacing": "Small",
          "items": [
            {
              "type": "TextBlock",
              "text": "${creditHeaderValue}",
              "size": "Small",
              "weight": "Bolder",
              "color": "Default",
              "isSubtle": true,
              "wrap": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${creditBalanceLine}",
      "size": "Small",
      "weight": "Default",
      "color": "Default",
      "isSubtle": false,
      "spacing": "None",
      "wrap": true,
      "$when": "${hasCredit}"
    },
    {
      "type": "ColumnSet",
      "spacing": "None",
      "$when": "${hasCreditLimitClickable}",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "${creditMonthlyLimitLabel}",
              "size": "Small",
              "isSubtle": true,
              "wrap": true,
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "spacing": "Small",
          "selectAction": {
            "type": "Action.Execute",
            "verb": "OpenSetLimit",
            "data": { "value": "${currentMonthlyLimitValue}" }
          },
          "items": [
            {
              "type": "TextBlock",
              "text": "${creditMonthlyLimitValue}",
              "size": "Small",
              "weight": "Bolder",
              "color": "Accent",
              "isSubtle": false,
              "wrap": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "None",
      "$when": "${hasCreditLimitPlain}",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "TextBlock",
              "text": "${creditMonthlyLimitLabel}",
              "size": "Small",
              "isSubtle": true,
              "wrap": true,
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "spacing": "Small",
          "items": [
            {
              "type": "TextBlock",
              "text": "${creditMonthlyLimitValue}",
              "size": "Small",
              "weight": "Bolder",
              "isSubtle": true,
              "wrap": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${promoCreditsLine}",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small",
      "wrap": true,
      "$when": "${hasPromoCredit}"
    },
    {
      "type": "ColumnSet",
      "spacing": "Medium",
      "verticalContentAlignment": "Center",
      "horizontalAlignment": "Left",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "selectAction": {
            "type": "Action.Execute",
            "verb": "Refresh",
            "title": "${refreshLabel}"
          },
          "items": [
            {
              "type": "Image",
              "url": "data:image/png;base64,",
              "width": "16px",
              "height": "16px"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "spacing": "Small",
          "items": [
            {
              "type": "TextBlock",
              "text": "${lastUpdated}",
              "size": "Small",
              "isSubtle": true,
              "wrap": false,
              "spacing": "None"
            }
          ]
        }
      ]
    }
  ]
}
