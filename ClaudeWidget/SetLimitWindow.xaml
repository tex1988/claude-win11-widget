<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ClaudeWidget.SetLimitWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ClaudeWidget"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ClaudeWidget"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="ClaudeWidget">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="24,20,24,24" VerticalAlignment="Top">
                <TextBlock x:Name="HeaderTextBlock"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="BodyTextBlock"
                           TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Spacing="8">
                    <TextBlock x:Name="InputLabelTextBlock"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <NumberBox x:Name="LimitNumberBox"
                               SpinButtonPlacementMode="Inline"
                               Minimum="0"
                               SmallChange="10"
                               LargeChange="100" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="False" />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Click="CancelButton_Click" />
                    <Button x:Name="SaveButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SaveButton_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
